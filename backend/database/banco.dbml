Table users {
  id integer [pk, increment]
  name text [not null]
  email text [unique, not null]
  password_hash text [not null]
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    email [name: 'idx_users_email']
  }
}

Table plant_catalog {
  id integer [pk, increment]
  popular_name text [not null]
  ideal_humidity real [not null]
  ideal_ph_min real [not null]
  ideal_ph_max real [not null]
  care_tips text
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Pre-loaded data so users do not need to know technical numbers. pH range varies per plant (e.g. lettuce 6.0-7.0, strawberry 5.5-6.5)'
}

Table devices {
  id integer [pk, increment]
  user_id integer [not null]
  name text [not null]
  location text
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    user_id [name: 'idx_devices_user_id']
  }

  Note: 'Physical hardware delivered to the customer. MAC address is managed internally by firmware'
}

Table my_crops {
  id integer [pk, increment]
  user_id integer [not null]
  plant_id integer [not null]
  device_id integer [not null]
  nickname text [not null]
  health_status text [not null, default: 'OK']
  last_watered_at text
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    user_id [name: 'idx_crops_user_id']
    plant_id [name: 'idx_crops_plant_id']
    device_id [name: 'idx_crops_device_id']
  }

  Note: 'CHECK health_status IN (OK, ALERT). ALERT automatically triggers irrigation.'
}

Table sensor_readings {
  id integer [pk, increment]
  crop_id integer [not null]
  humidity_value real [not null]
  ph_value real [not null]
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (crop_id, created_at) [name: 'idx_sensor_crop_history']
  }

  Note: 'pH scale: 0.0 to 14.0. Ideal range is defined per plant in plant_catalog'
}

Table irrigation_logs {
  id integer [pk, increment]
  crop_id integer [not null]
  origin text [not null, default: 'AUTO']
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (crop_id, created_at) [name: 'idx_irrigation_crop_history']
  }

  Note: 'CHECK origin IN (AUTO, MANUAL)'
}

Ref: devices.user_id > users.id [delete: cascade]
Ref: my_crops.user_id > users.id [delete: cascade]
Ref: my_crops.plant_id > plant_catalog.id
Ref: my_crops.device_id > devices.id [delete: cascade]
Ref: sensor_readings.crop_id > my_crops.id [delete: cascade]
Ref: irrigation_logs.crop_id > my_crops.id [delete: cascade]