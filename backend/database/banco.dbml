Table users {
  id integer [pk, increment]
  name text [not null]
  email text [unique, not null]
  password_hash text [not null]
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    email [name: 'idx_users_email']
  }
}

Table plant_catalog {
  id integer [pk, increment]
  popular_name text [not null]
  ideal_humidity real [not null]
  ideal_ph_min real [not null]
  ideal_ph_max real [not null]
  ideal_salinity_min real [not null]
  ideal_salinity_max real [not null]
  care_tips text
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  Note: 'Dados pré-carregados para que os usuários não precisem conhecer números técnicos. A faixa de pH varia de acordo com a planta (por exemplo, alface 6,0–7,0; morango 5,5–6,5)'
}

Table my_crops {
  id integer [pk, increment]
  user_id integer [not null]
  plant_id integer [not null]
  device_code text [unique, not null]
  nickname text [not null]
  health_status text [not null, default: 'OK']
  last_watered_at text
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    user_id [name: 'idx_crops_user_id']
    plant_id [name: 'idx_crops_plant_id']
    device_code [name: 'idx_crops_device_code']
  }

  Note: 'Verifique se health_status está em (OK, ALERT). ALERT aciona automaticamente a irrigação. device_code está diretamente vinculado ao Arduino físico.'
}

Table sensor_readings {
  id integer [pk, increment]
  crop_id integer [not null]
  humidity_value real [not null]
  ph_value real [not null]
  salinity_value real [not null]
  log_status text [not null, default: 'OK']
  log_message text
  created_at text [not null, default: `CURRENT_TIMESTAMP`]
  updated_at text [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (crop_id, created_at) [name: 'idx_sensor_crop_history']
  }

  Note: 'Verifique se **log_status** está em (OK, WARNING, ERROR). **log_message** armazena detalhes quando **log_status** não é OK.'
}

Ref: my_crops.user_id > users.id [delete: cascade]
Ref: my_crops.plant_id > plant_catalog.id
Ref: sensor_readings.crop_id > my_crops.id [delete: cascade]